# Copy to .env and fill in. Never share this file.
NANSEN_API_KEY=

# Only needed for live trading. GMGN keys are stored by gmgn-cli in ~/.config/gmgn/.env
# (run `gmgn-cli config`). Put your trading wallet's public address here:
GMGN_WALLET_ADDRESS=

# Second lock for real money. Must be exactly "yes" plus trading_mode = "live" in config.toml.
LIVE_TRADING_CONFIRM=no

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
